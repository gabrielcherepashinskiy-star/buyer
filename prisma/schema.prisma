// SHOP SELECT NYC — Buying Desk
// Records outright purchases (cost + resale price + condition), pushes to
// Shopify, syncs to Google Sheets, and emails receipts to sellers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection string comes from the DATABASE_URL environment variable set in
  // Vercel — never hardcode a credential in this file.
  url = env("DATABASE_URL")
}

model Purchase {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Human-friendly identifiers
  sku           String @unique
  receiptNumber String @unique

  // Product details
  title       String
  brand       String?
  category    String?
  size        String? // e.g. shoe/clothing size, when applicable
  condition   String // New, Like New, Excellent, Very Good, Good, Fair
  description String?
  quantity    Int     @default(1)

  // Money (stored in cents to avoid float errors)
  costCents  Int // what we paid the seller
  priceCents Int // resale price we set
  currency   String @default("USD")

  // Who logged this purchase (one of the master-key holders)
  recordedBy String?

  // Seller (exactly what we collect: full name, government ID #, email)
  sellerName    String
  sellerEmail   String
  sellerIdEnc   String? // encrypted government ID number
  sellerIdLast4 String? // last 4 chars for display/verification

  // Shopify sync
  shopifyProductId String?
  shopifyVariantId String?
  shopifyHandle    String?
  shopifyStatus    String  @default("pending") // pending | active | error | skipped
  shopifyError     String?
  shopifySyncedAt  DateTime?

  // Google Sheets sync
  sheetSyncedAt DateTime?
  sheetError    String?

  // Receipt
  receiptSentAt DateTime?
  receiptError  String?

  @@index([createdAt])
  @@index([sellerEmail])
}

// A public "sell to us" submission from the seller intake page. This is a
// lead/quote request — not a purchase. Admin reviews it and follows up.
model Submission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status String @default("new") // new | reviewed | quoted | closed

  // Contact (window 1)
  contactName  String
  contactPhone String
  contactEmail String

  // How they'll get items to us (window 3): instore | ship
  method String

  note String?

  items  SubmissionItem[]
  photos SubmissionPhoto[]

  @@index([createdAt])
  @@index([status])
}

model SubmissionPhoto {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Stored as a compressed JPEG data URL (base64). Client shrinks it first.
  dataUrl String @db.Text

  @@index([submissionId])
}

model SubmissionItem {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  name              String
  desiredPriceCents Int    @default(0)
  quantity          Int    @default(1)
  notes             String?

  @@index([submissionId])
}
