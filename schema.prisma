// SHOP SELECT NYC — Buying Desk
// Records outright purchases (cost + resale price + condition), pushes to
// Shopify, syncs to Google Sheets, and emails receipts to sellers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection string set directly so the build/runtime don't depend on
  // Vercel env vars. NOTE: this is a live credential in the repo — after the
  // app is confirmed working, rotate the Neon password and switch this line
  // back to url = env("DATABASE_URL").
  url = "postgresql://neondb_owner:npg_J0Z5xaITjoDU@ep-weathered-paper-awb8ejho.c-12.us-east-1.aws.neon.tech/neondb?sslmode=require"
}

model Purchase {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Human-friendly identifiers
  sku           String @unique
  receiptNumber String @unique

  // Product details
  title       String
  brand       String?
  category    String?
  condition   String // New, Like New, Excellent, Very Good, Good, Fair
  description String?
  quantity    Int     @default(1)

  // Money (stored in cents to avoid float errors)
  costCents  Int // what we paid the seller
  priceCents Int // resale price we set
  currency   String @default("USD")

  // Who logged this purchase (one of the master-key holders)
  recordedBy String?

  // Seller (exactly what we collect: full name, government ID #, email)
  sellerName    String
  sellerEmail   String
  sellerIdEnc   String? // encrypted government ID number
  sellerIdLast4 String? // last 4 chars for display/verification

  // Shopify sync
  shopifyProductId String?
  shopifyVariantId String?
  shopifyHandle    String?
  shopifyStatus    String  @default("pending") // pending | active | error | skipped
  shopifyError     String?
  shopifySyncedAt  DateTime?

  // Google Sheets sync
  sheetSyncedAt DateTime?
  sheetError    String?

  // Receipt
  receiptSentAt DateTime?
  receiptError  String?

  @@index([createdAt])
  @@index([sellerEmail])
}
